| Drag.mac - by Noobhaxor, updated for current MacroQuest.
| Register player corpses within 100 units. Gather to 25 units, then
| pull again when a registered corpse exceeds 40 units.
| Stop with /endmacro. Consent and normal server restrictions still apply.

#turbo
#event Denied "#*#You do not have consent#*#"
#event Denied "#*#You do not have permission#*#corpse#*#"

Sub Main
    /declare corpseCount int local ${SpawnCount[pccorpse radius 100]}
    /declare corpseIndex int local 0
    /declare remaining int local 0
    /declare corpseId int local 0
    /declare corpseDistance float local 0
    /declare requestSlot int outer 0

    /if (${corpseCount}<=0) {
        /echo Drag: No player corpses within 100 units.
        /endmacro
    }

    | Snapshot all IDs before a pull can change nearest-spawn order.
    /declare dragIds[${corpseCount}] int outer 0
    /declare dragNeedsPull[${corpseCount}] int outer 1
    /for corpseIndex 1 to ${corpseCount}
        /if (${NearestSpawn[${corpseIndex},pccorpse radius 100].ID}) {
            /varset dragIds[${corpseIndex}] ${NearestSpawn[${corpseIndex},pccorpse radius 100].ID}
            /echo Drag: Registered ${Spawn[id ${dragIds[${corpseIndex}]}].CleanName} (ID ${dragIds[${corpseIndex}]}).
        }
    /next corpseIndex
    /echo Drag: Tracking ${corpseCount} player corpses. Gather at 25, re-pull past 40 units. /endmacro to stop.

    :mainloop
    /varset remaining 0
    /for corpseIndex 1 to ${corpseCount}
        | Process consent messages before selecting a different corpse.
        /doevents Denied
        /varset corpseId ${dragIds[${corpseIndex}]}
        /if (${corpseId}>0) {
            /if (${Spawn[id ${corpseId} pccorpse].ID}) {
                /varcalc remaining ${remaining}+1
                /varset corpseDistance ${Spawn[id ${corpseId}].Distance3D}
                /if (${corpseDistance}<=25) /varset dragNeedsPull[${corpseIndex}] 0
                /if (${corpseDistance}>40) /varset dragNeedsPull[${corpseIndex}] 1
                /if (${dragNeedsPull[${corpseIndex}]}) {
                    /target id ${corpseId} pccorpse
                    /if (${Target.ID}==${corpseId} && ${Spawn[id ${corpseId} pccorpse].ID}) {
                        /varset requestSlot ${corpseIndex}
                        /corpse
                        /doevents Denied
                        /if (${Spawn[id ${corpseId} pccorpse].ID} && ${Spawn[id ${corpseId}].Distance3D}<=25) /varset dragNeedsPull[${corpseIndex}] 0
                    }
                }
            } else {
                | Rezzed or despawned; do not target a reused non-corpse ID.
                /varset dragIds[${corpseIndex}] 0
            }
        }
    /next corpseIndex
    /if (${remaining}==0) {
        /echo Drag: No remaining registered player corpses.
        /endmacro
    }
    /goto :mainloop
/return

Sub Event_Denied
    /if (${requestSlot}>0) {
        | These messages do not supply a spawn ID. Associate them with the
        | latest pull; ignore stale errors if that corpse has already arrived.
        /if (${dragIds[${requestSlot}]}>0) {
            /if (${Spawn[id ${dragIds[${requestSlot}]} pccorpse].ID} && ${Spawn[id ${dragIds[${requestSlot}]}].Distance3D}>25) {
                /echo Drag: Consent denied for corpse ID ${dragIds[${requestSlot}]}; excluding it.
                /varset dragIds[${requestSlot}] 0
            }
        }
        /varset requestSlot 0
    }
/return
