+-- Exact group camp anchors use the same command on every class, survive
+-- normal combat stick movement, and return with Z-aware navigation.
+local savedCampValues=mock.values
+mock.values={['Zone.ID']='101',['Me.X']='-1764.875',['Me.Y']='-1734.125',['Me.Z']='5.25',
+    ['Me.XTarget[1].ID']='0',['Me.XTarget']='0',['Me.Combat']='FALSE',
+    ['Me.Casting.ID']='0',['Stick.Status']='OFF',['Navigation.MeshLoaded']='TRUE'}
+local Camp=require('automacros.camp')
+local campWar
+for _,class in ipairs({'clr','brd','war','mnk'}) do
+    local r=setup(class)
+    r:dispatch('campcoords','-1734.125','-1764.875','5.25','101')
+    eq(r:get({},'AutoCampY'),-1734.125,class..' exact Y')
+    eq(r:get({},'AutoCampX'),-1764.875,class..' exact X')
+    eq(r:get({},'AutoCampZ'),5.25,class..' exact Z')
+    eq(r:get({},'ReturnToCamp'),1,class..' group camp enabled')
+    if class=='mnk' then
+        eq(r.monk.camp.x,-1764.875,'monk pull anchor matches common X')
+        eq(r.monk.camp.y,-1734.125,'monk pull anchor matches common Y')
+        eq(r.monk.camp.z,5.25,'monk pull anchor matches common Z')
+    elseif class=='war' then campWar=r end
+end
+campWar:dispatch('groupcamphere')
+eq(mock.commands[#mock.commands],'/dggaexecute /autolua campcoords -1734.125 -1764.875 5.250 101','group broadcast exact coordinates')
+eq(Camp.request(campWar,0,0,0,102),false,'do not apply coordinates from another zone')
+mock.values['Me.XTarget[1].ID']='99'
+Camp.request(campWar,-1735,-1765,6,101)
+eq(campWar:get({},'AutoCampY'),-1734.125,'defer camp changes while fighting')
+mock.values['Me.XTarget[1].ID']='0'
+Camp.beforePulse(campWar)
+eq(campWar:get({},'AutoCampY'),-1735,'apply queued anchor after combat')
+mock.values['Me.Y']='-1635'
+mock.values['Stick.Status']='ON';campWar.campStickOwned=true
+campWar:call('autocampcheck')
+eq(mock.commands[#mock.commands],'/stick off','release old combat stick without disabling camp')
+eq(campWar:get({},'ReturnToCamp'),1,'camp remains enabled after combat')
+mock.values['Stick.Status']='OFF';mock.values['Stick.Active']='FALSE'
+campWar:call('autocampcheck')
+eq(mock.commands[#mock.commands],'/nav loc -1735.000 -1765.000 6.000 distance=5','return to shared XYZ anchor')
+mock.values['Me.XTarget[1].ID']='99'
+Camp.beforePulse(campWar)
+eq(mock.commands[#mock.commands],'/nav stop','combat interrupts owned camp return')
+mock.values=savedCampValues
+print('PASS four-class group XYZ camp, broadcast, safe deferred changes and owned movement')
+
 require('automacros.tests.test_gui')(setup,mock,eq)

