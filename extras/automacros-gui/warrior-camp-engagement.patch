+-- The usual 60-unit gate must not strand the tank when an actual
+-- encounter stops slightly farther away but remains within camp. Keep the
+-- existing 100-unit hostile scan cap; never extend pursuit based solely on
+-- distance from the warrior or an unvalidated camp anchor.
+local function inCampEngagement(r,chosen)
+    if r:get({},'ReturnToCamp')~=1 or r:get({},'AutoCampZone')~=num(r,'Zone.ID') or
+        num(r,'Zone.ID')<=0 or not yes(r,'Target.LineOfSight') then return false end
+    local y,x,z=tonumber(read(r,'Target.Y')),tonumber(read(r,'Target.X')),tonumber(read(r,'Target.Z'))
+    local cy,cx,cz=r:get({},'AutoCampY'),r:get({},'AutoCampX'),r:get({},'AutoCampZ')
+    if not (y and x and z and cy and cx and cz) then return false end
+    local radius=math.min(100,math.max(60,(r:get({},'AutoCampRadius') or 30)+40))
+    return chosen.distance<=100 and (y-cy)^2+(x-cx)^2+(z-cz)^2<=radius^2
 end
