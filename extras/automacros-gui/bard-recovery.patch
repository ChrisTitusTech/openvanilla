+-- A non-mana melee class reports 0% mana. Only actual mana pools
+-- qualify, and Crescendo also restores health and endurance.
+local function groupNeedsRecovery(r)
+    local count=math.min(5,num(r,'Group.Members'))
+    if count<=0 then return false end
+    for i=1,count do
+        local e='Group.Member['..i..']'
+        local hp=tonumber(read(r,e..'.PctHPs'))
+        if num(r,e..'.ID')>0 and hp and hp>0 and read(r,e..'.Offline')~='TRUE' and read(r,e..'.OtherZone')~='TRUE' then
+            local mana=tonumber(read(r,e..'.PctMana'))
+            local endu=tonumber(read(r,e..'.PctEndurance'))
+            if hp<85 or (num(r,e..'.MaxMana')>0 and mana and mana<80) or
+               (num(r,e..'.MaxEndurance')>0 and endu and endu<80) then return true end
+        end
+    end
+    return num(r,'Me.PctHPs')<85 or num(r,'Me.PctEndurance')<80
+end
 -- Essential group buffs get the first available cast before expiry. The
 -- remaining-time deadline includes the *next* song's cast budget, not only
