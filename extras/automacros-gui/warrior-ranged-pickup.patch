+-- Inspect the union of the NPCs around the tank and selected target.
+-- Never assume raw nearby spawn counts are all engaged enemies. The scan
+-- fails closed if positions or the native spawn API are unavailable.
+local function nearbyNPCs(r,radius)
+    local w=state(r);local now=mq.gettime();local id=num(r,'Target.ID')
+    local cached=w.nearby
+    if cached and cached.id==id and cached.radius==radius and now<cached.untilTime then return cached.ids end
+    if type(mq.getFilteredSpawns)~='function' then return nil end
+    local mx,my,mz=tonumber(read(r,'Me.X')),tonumber(read(r,'Me.Y')),tonumber(read(r,'Me.Z'))
+    local tx,ty,tz=tonumber(read(r,'Target.X')),tonumber(read(r,'Target.Y')),tonumber(read(r,'Target.Z'))
+    if not (mx and my and mz and tx and ty and tz) then return nil end
+    local rr=radius^2
+    local ok,near=pcall(mq.getFilteredSpawns,function(sp)
+        if sp.Type()~='NPC' then return false end
+        local x,y,z=sp.X(),sp.Y(),sp.Z()
+        return x and y and z and ((x-mx)^2+(y-my)^2+(z-mz)^2<=rr or (x-tx)^2+(y-ty)^2+(z-tz)^2<=rr)
+    end)
+    if not ok or type(near)~='table' then return nil end
+    local ids={};local seen={}
+    for _,sp in ipairs(near) do
+        local sid=sp.ID()
+        if sid and sid>0 and not seen[sid] then seen[sid]=true;ids[#ids+1]=sid end
+    end
+    w.nearby={id=id,radius=radius,ids=ids,untilTime=now+500}
+    return ids
+end
+function M.safeAreaAggro(r)
+    -- Area taunts remain useful on existing packs, but never acquire
+    -- bystanders. Use a conservative 60-unit union around both centers.
+    if (r.warriorHostileCount or 0)<2 then return false end
+    local ids=nearbyNPCs(r,60)
+    if not ids or #ids<2 then return false end
+    for _,id in ipairs(ids) do if not (r.warriorXTIds and r.warriorXTIds[id]) then return false end end
+    return true
+end
