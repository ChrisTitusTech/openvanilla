+local function castBusy(r)
+    local status=read(r,'Cast.Status')
+    return status~='I' and status~='NULL' and status~='',status
+end
+local function priorityAA(r,s,id,name,hp,critical)
+    local hard=num(r,'Me.XTarget')>=3 or read(r,'Me.XTarget[1].Named')=='TRUE' or
+        (r.tankMinimum or 100)<=55
+    local now=mq.gettime()
+    r.tankAANext=r.tankAANext or {}
+    local function ready(key,aa)
+        return now>=(r.tankAANext[key] or 0) and read(r,'Me.AltAbilityReady['..aa..']')=='TRUE'
+    end
+    local function activate(key,aa,target,label)
+        if castBusy(r) then return true end
+        r.tankAANext[key]=now+3000 -- only pace rejected/unconfirmed activations
+        r:log('Priority '..label..' AA tank='..name..' hp='..hp..' ability='..key)
+        r:call('aanow',tostring(aa),target)
+        return true
+    end
+    -- On a hard fight, use instant lifesaving AAs while there is still room
+    -- to survive another hit, rather than waiting for near-death health.
+    if hp<=math.max(hard and 55 or 40,r:get(s,'clickhealpoint') or 35) and
+       (r:get(s,'ClickHealTimer') or 0)==0 and ready('Burst of Life','Burst of Life') then
+        if castBusy(r) then return true end
+        r:set(s,'ClickHealTimer','2s')
+        return activate('Burst of Life',7689,id,'emergency')
+    end
+    if hp>75 and not hard then return false end
+    local selfHp=num(r,'Me.PctHPs')
+    local hurt,healthy,otherCritical=0,0,false
+    local function sample(memberId,memberHp)
+        if memberId~=id and memberId>0 and memberHp>0 then
+            if memberHp<=75 then hurt=hurt+1 end
+            if memberHp>=hp+25 then healthy=healthy+1 end
+            if memberHp<=35 then otherCritical=true end
+        end
+    end
+    sample(num(r,'Me.ID'),selfHp)
+    for i=1,math.min(5,num(r,'Group.Members')) do
+        local m='Group.Member['..i..']'
+        sample(num(r,m..'.ID'),num(r,m..'.PctHPs'))
+    end
+    if hp<=35 and healthy>=2 and not otherCritical and (r:get(s,'ClickHealTimer') or 0)==0 and
+       ready('Divine Arbitration','Divine Arbitration') then
+        if castBusy(r) then return true end
+        r:set(s,'ClickHealTimer','2s')
+        return activate('Divine Arbitration',169,num(r,'Me.ID'),'emergency')
+    end
+    if hp<=75 and hurt>=1 and ready('Beacon of Life',137) then
+        return activate('Beacon of Life',137,num(r,'Me.ID'),'group heal')
+    end
+    -- Protective/regen AAs must get a turn before a hard fight's tank is
+    -- critical. Do not spend that time on cooldowns when a direct heal is urgent.
+    if hard and hp>critical and not otherCritical then
+        for _,aa in ipairs({{'Divine Guardian',463},{'Focused Celestial Regeneration',1065}}) do
+            if ready(aa[1],aa[2]) then return activate(aa[1],aa[2],id,'preventive') end
+        end
+    end
+    return false
+end
