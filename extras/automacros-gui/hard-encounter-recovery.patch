 -- While MQ2Cast is yielding, sample tank HP and optionally preempt a long
 -- non-tank cast only if the tank is much worse off and an urgent heal is ready.
+local function hardEncounter(r)
+    return num(r,'Me.XTarget')>=3 or read(r,'Me.XTarget[1].Named')=='TRUE'
+end
+local function arbitrationSafe(r,id,hp)
+    local healthy,critical,seen=0,false,{}
+    local function sample(mid,mhp)
+        if mid~=id and mid>0 and mhp>0 and not seen[mid] then
+            seen[mid]=true
+            if mhp>=hp+25 then healthy=healthy+1 end
+            if mhp<=35 then critical=true end
+        end
+    end
+    sample(num(r,'Me.ID'),num(r,'Me.PctHPs'))
+    for i=1,math.min(5,num(r,'Group.Members')) do
+        local e='Group.Member['..i..']';sample(num(r,e..'.ID'),num(r,e..'.PctHPs'))
+    end
+    return healthy>=2 and not critical
+end
