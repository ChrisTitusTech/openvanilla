+local function encounter(r)
+    local count=num(r,'Me.XTarget')
+    if count<=0 then return 0,false,{} end
+    local slots=math.min(40,math.max(1,count,num(r,'Me.XTargetSlots')))
+    local seen,n,named,occupied={},0,false,0
+    local radius=(r:get({},'AutoCampRadius') or 60)+20
+    for i=1,slots do
+        local id=num(r,'Me.XTarget['..i..'].ID')
+        if id>0 then occupied=occupied+1 end
+        local e='Spawn[id '..id..']'
+        if id>0 and not seen[id] and read(r,e..'.Type')=='NPC' and
+            read(r,e..'.Dead')~='TRUE' and num(r,e..'.Distance')<=radius then
+            seen[id]=true;n=n+1
+            if read(r,e..'.Named')=='TRUE' then named=true end
+        end
+        if occupied>=count then break end
+    end
+    return n,named,seen
+end
+local function releaseSong(r)
+    if num(r,'Me.Casting.ID')>0 then
+        r:command({},'/stopcast');mq.delay(500,function() return num(r,'Me.Casting.ID')==0 end)
+    end
+    return num(r,'Me.Casting.ID')==0
+end
+local function aa(r,name,id,target,slack,reason)
+    local now=mq.gettime()
+    r.bardAANext=r.bardAANext or {}
+    if now<(r.bardAANext[name] or 0) or
+        (read(r,'Me.AltAbilityReady['..name..']')~='TRUE' and read(r,'Me.AltAbilityReady['..id..']')~='TRUE') then return false end
+    local cast=num(r,'Me.AltAbility['..id..'].Spell.MyCastTime.Raw')
+    if slack<cast+1500 then return false end
+    r.bardAANext[name]=now+3000
+    -- castready has expired; stop only the held/repeating song before an AA.
+    if not releaseSong(r) then return false end
+    r:log('Bard AA request='..name..' reason='..reason..' target='..tostring(target or 0))
+    r:call('aanow',tostring(id),target or 0)
+    return true
+end
+function M.defense(r)
+    if (r:get({},'castready') or 0)>0 or read(r,'Me.Invis')=='TRUE' or
+        read(r,'Me.Stunned')=='TRUE' or read(r,'Me.State')=='STUN' or read(r,'Me.State')=='FEIGN' then return false end
+    local hp=num(r,'Me.PctHPs')
+    if num(r,'Me.XTarget[1].ID')>0 and hp>0 and hp<=70 then
+        return aa(r,'Shield of Notes',361,nil,math.huge,'low-health-defense')
+    end
+    return false
+end
+local function burn(r,slack)
+    local n,named,seen=encounter(r)
+    if not named and n<3 then return false end
+    local reason=named and 'named' or 'three-plus-mobs'
+    local id=num(r,'Target.ID')
+    local target=seen[id] and id or nil
+    -- Group support first increases damage and healing before the encounter
+    -- gets dangerous. Targeted damage AAs require an actual encounter NPC.
+    for _,a in ipairs({{'Fierce Eye',3506},{'Quick Time',3702},{'Dance of Blades',359},
+        {'Funeral Dirge',777,true},{'Bladed Song',669,true},{'Song of Stone',544,true}}) do
+        if (not a[3] or target) and aa(r,a[1],a[2],a[3] and target or nil,slack,reason) then return true end
+    end
+    -- Preserve the existing epic and discipline, one action per safe slot.
+    local epic=r:get({},'epicsword')
+    local now=mq.gettime()
+    r.bardAANext=r.bardAANext or {}
+    if epic and epic~='NULL' and num(r,'FindItem['..epic..'].ID')>0 and
+        read(r,'Me.ItemReady['..epic..']')=='TRUE' and
+        now>=(r.bardAANext[epic] or 0) and slack>num(r,'FindItem['..epic..'].CastTime.Raw')+1500 then
+        r.bardAANext[epic]=now+3000
+        if not releaseSong(r) then return false end
+        r:log('Bard burn item='..epic..' reason='..reason)
+        r:call('itemnow',epic);return true
+    end
+    if target and num(r,'Me.PctEndurance')>20 and read(r,'Me.CombatAbilityReady[Thousand Blades]')=='TRUE' and
+        now>=(r.bardAANext['Thousand Blades'] or 0) and slack>1500 then
+        r.bardAANext['Thousand Blades']=now+3000
+        if not releaseSong(r) then return false end
+        r:log('Bard burn discipline=Thousand Blades reason='..reason)
+        r:call('discnow','Thousand Blades');return true
+    end
+    return false
+end
 -- Essential group buffs get the first available cast before expiry. The
