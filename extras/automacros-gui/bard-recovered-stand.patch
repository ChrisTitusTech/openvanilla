 function M.scheduleCombat(r,downtime)
     if (r:get({},'castready') or 0)>0 then return false end
     local now=mq.gettime()
+    if read(r,'Me.Stunned')=='TRUE' or read(r,'Me.State')=='STUN' then return false end
+    if downtime and read(r,'Me.Sitting')=='TRUE' then
+        -- The legacy sitcheck only stands on movement or combat; when
+        -- recovery completes at camp, stand so core support can resume.
+        if num(r,'Me.PctHPs')>=90 and num(r,'Me.PctMana')>80 and num(r,'Me.PctEndurance')>80
