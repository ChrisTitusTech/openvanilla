+            r.bardStandAt=now+500
+            r:set({},'enablesit',0)
+            r:command({},'/stand')
+            r:log('Bard recovered; standing to maintain core songs')
+            return true
+        end
+        return false
+    end
+    if downtime and read(r,'Me.Standing')~='TRUE' then return false end
     r.songAttempts=r.songAttempts or {}
